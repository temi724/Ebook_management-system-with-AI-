# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Matches venv311/ and any other suffixed virtualenv, which a bare "venv/"
# rule does not — that gap is why venv311/bin was committed while its
# site-packages was ignored, leaving a virtualenv skeleton with no packages.
venv*/
ENV/
env/

# Database
*.db
*.sqlite3

# Environment
.env
.env.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Uploads
uploads/
*.pdf
*.jpg
*.jpeg
*.png

# ...but the app's own branding is source, not an upload. Without these
# exceptions the logo is missing from a fresh clone and every <img src="/logo.jpeg">
# renders broken.
!frontend/public/logo.jpeg
!frontend/logo.jpeg

# Node
node_modules/
dist/
.cache/

# Testing
.pytest_cache/
coverage/
htmlcov/
.coverage

# ChromaDB
chroma/
